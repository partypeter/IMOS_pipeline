#!/bin/bash
#PBS -N prune_scan
#PBS -q normal
#PBS -l ncpus=16
#PBS -l mem=64GB
#PBS -l jobfs=200GB
#PBS -l walltime=12:00:00
#PBS -l storage=gdata/sh74+gdata/uc0
#PBS -l wd
#PBS -j oe
# ------------------------------------------------------------------
#- IMPLEMENTATION
#- author      Hannes Hollmann, National Computational Infrastructure
#- license     GNU General Public License
# ------------------------------------------------------------------
# SYNOPSIS
#    cd <repo checkout> && qsub -P <project> prune_scan.pbs
#    Optional: -v OUT=<dir>,JOBS=<n>,SORT_MEM=<size>,PYTHON=<interpreter>
#
# DESCRIPTION
#    One-time maintenance job, not part of the daily pipeline. Read-only:
#    finds every persistent-manifest entry with no file on disk and writes
#    them to $OUT/missing.lst (absolute paths, one per line), for
#    prune_manifest_from_list.py to apply afterwards.
#
#    Lists directories instead of checking files one at a time, run on a
#    Gadi node where /g/data is native Lustre rather than NFS:
#      1. prune_scan_helper.py writes every manifest entry as an absolute
#         path (from the manifest backup on /g/data, as of the last
#         pipeline run — backup_manifests.py), plus the directories two levels below each base that the
#         entries live under (e.g. IMOS_AODN/IMOS/AUV).
#      2. Each of those roots is split into tasks — the files directly in
#         the root and in each child directory, plus every grandchild
#         directory recursively — listed with find, JOBS at a time.
#      3. Both sides are sorted on node-local jobfs and compared with
#         comm: entries with no file on disk are the result.
#    Any listing failure aborts the job without writing missing.lst — an
#    unlisted directory would make all its files look missing.
#
#    Defaults: OUT=<submit dir>/prune_scan_<job id>, JOBS=ncpus,
#    SORT_MEM=24G (sorts run one at a time; keep well under mem).
#
# VERSION
#    1.0: Initial implementation
#    1.1: Manifests are read from the backup on /g/data (see
#         prune_scan_helper.py 1.1).
#
# ================================================================
# END_OF_HEADER
# ================================================================

set -euo pipefail
export LC_ALL=C

REPO="${REPO:-${PBS_O_WORKDIR:-$(cd "$(dirname "$0")" && pwd)}}"
JOBID="${PBS_JOBID:-$(date +%Y%m%d%H%M%S)}"
OUT="${OUT:-$REPO/prune_scan_${JOBID%%.*}}"
JOBS="${JOBS:-${PBS_NCPUS:-$(nproc)}}"
SORT_MEM="${SORT_MEM:-24G}"
PYTHON="${PYTHON:-python3}"
if [ -n "${PBS_JOBFS:-}" ]; then
  WORK="$PBS_JOBFS/prune_scan"
else
  WORK="$(mktemp -d)"
  trap 'rm -rf "$WORK"' EXIT
fi

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*"; }
die() { log "ERROR: $*"; exit 1; }

mkdir -p "$OUT" "$WORK/chunks"
: > "$WORK/failed"
log "Repo: $REPO | output: $OUT | scratch: $WORK | jobs: $JOBS | $("$PYTHON" --version 2>&1)"
log "Filesystem: $(df -T /g/data/sh74 2>/dev/null | tail -1 | awk '{print $2}')"

# --- 1. Manifest side ----------------------------------------------------
log "Reading manifests"
"$PYTHON" "$REPO/prune_scan_helper.py" keys \
  "$WORK/manifest_paths.unsorted" "$WORK/roots" "$WORK/shallow_missing"
sort -u -S "$SORT_MEM" --parallel="$JOBS" -T "$WORK" \
  -o "$WORK/manifest_paths" "$WORK/manifest_paths.unsorted"
rm "$WORK/manifest_paths.unsorted"
cp "$WORK/roots" "$OUT/scanned_roots.txt"
log "$(wc -l < "$WORK/manifest_paths") distinct manifest entries under $(wc -l < "$WORK/roots") roots"

# --- 2. Disk side ---------------------------------------------------------
# Tasks are NUL-separated "F<dir>" (files directly in dir) or "T<dir>"
# (everything under dir), so any directory name survives the trip.
log "Building listing tasks"
: > "$WORK/tasks"
while IFS= read -r root; do
  if [ ! -d "$root" ]; then
    parent="$(dirname "$root")"
    [ -r "$parent" ] && [ -x "$parent" ] || die "cannot read $parent, so can't tell whether $root exists"
    log "Absent on disk (all its entries will count as missing): $root"
    continue
  fi
  printf 'F%s\0' "$root" >> "$WORK/tasks"
  find "$root" -mindepth 1 -maxdepth 1 -type d -print0 > "$WORK/children" || die "cannot list $root"
  while IFS= read -r -d '' child; do
    printf 'F%s\0' "$child" >> "$WORK/tasks"
    find "$child" -mindepth 1 -maxdepth 1 -type d -printf 'T%p\0' >> "$WORK/tasks" || die "cannot list $child"
  done < "$WORK/children"
done < "$WORK/roots"

scan_task() {
  local mode="${1:0:1}" dir="${1:1}" out
  out="$(mktemp "$WORK/chunks/c.XXXXXXXX")" || { printf '%s\n' "$dir" >> "$WORK/failed"; return 0; }
  if [ "$mode" = F ]; then
    find "$dir" -mindepth 1 -maxdepth 1 \( -type f -o -type l \) -print > "$out" || printf '%s\n' "$dir" >> "$WORK/failed"
  else
    find "$dir" \( -type f -o -type l \) -print > "$out" || printf '%s\n' "$dir" >> "$WORK/failed"
  fi
}
export -f scan_task
export WORK

log "Listing files: $(tr -cd '\0' < "$WORK/tasks" | wc -c) tasks, $JOBS at a time"
xargs -0 -r -P "$JOBS" -n 1 bash -c 'scan_task "$1"' _ < "$WORK/tasks"

if [ -s "$WORK/failed" ]; then
  cp "$WORK/failed" "$OUT/failed_dirs.txt"
  die "listing failed for $(wc -l < "$WORK/failed") director(ies), see $OUT/failed_dirs.txt and the find errors above. No missing.lst written: their files would have been reported missing."
fi

log "Sorting disk listing"
find "$WORK/chunks" -type f -print0 | xargs -0 cat \
  | sort -S "$SORT_MEM" --parallel="$JOBS" -T "$WORK" -o "$WORK/disk_paths"
rm -rf "$WORK/chunks"
log "$(wc -l < "$WORK/disk_paths") files on disk under the scanned roots"

# --- 3. Compare -----------------------------------------------------------
comm -23 "$WORK/manifest_paths" "$WORK/disk_paths" > "$WORK/missing"
sort -u -o "$OUT/missing.lst" "$WORK/missing" "$WORK/shallow_missing"

{
  echo "Scan finished $(date '+%Y-%m-%d %H:%M:%S') (job ${JOBID})"
  echo "Manifest entries:         $(wc -l < "$WORK/manifest_paths")"
  echo "Files on disk (scanned):  $(wc -l < "$WORK/disk_paths")"
  echo "Missing from disk:        $(wc -l < "$OUT/missing.lst")"
  echo
  echo "Missing per prefix:"
  "$PYTHON" "$REPO/prune_scan_helper.py" summary "$OUT/missing.lst"
} | tee "$OUT/summary.txt"
log "Done. Result: $OUT/missing.lst"
